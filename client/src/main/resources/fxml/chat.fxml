<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chat.controller.ChatController">

    <!-- Top: Connection Panel -->
    <top>
        <VBox spacing="10" style="-fx-background-color: #f0f0f0; -fx-padding: 10;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Server IP:" />
                <TextField fx:id="serverIpField" prefWidth="120" />

                <Label text="Port:" />
                <TextField fx:id="serverPortField" prefWidth="60" />

                <Label text="Username:" />
                <TextField fx:id="usernameField" prefWidth="100" />

                <Button fx:id="connectButton" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Conectare" />
            </HBox>

            <Label fx:id="statusLabel" style="-fx-font-weight: bold; -fx-text-fill: red;" text="Deconectat" />
        </VBox>
    </top>

    <!-- Center: Chat Area -->
    <center>
        <TextArea fx:id="chatArea" editable="false" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 12px;" wrapText="true">
            <BorderPane.margin>
                <Insets bottom="5" left="5" right="5" top="5" />
            </BorderPane.margin>
        </TextArea>
    </center>

    <!-- Bottom: Message Input -->
    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;">
            <TextField fx:id="messageInput" promptText="Scrie mesajul tău aici..." style="-fx-font-size: 13px;" HBox.hgrow="ALWAYS" />

            <Button fx:id="sendButton" prefWidth="80" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;" text="Trimite" />
        </HBox>
    </bottom>

</BorderPane>
